# Contentful CMS (Required for /life and /skills certificates)
CONTENTFUL_SPACE_ID=your_contentful_space_id
CONTENTFUL_ACCESS_TOKEN=your_contentful_access_token

# ISR Revalidation Secret (Protects POST /api/revalidate)
REVALIDATE_SECRET=your_revalidate_secret_token

# Pusher Server Keys
PUSHER_APP_ID=your_pusher_app_id
PUSHER_SECRET=your_pusher_secret

# Pusher Client Keys
NEXT_PUBLIC_PUSHER_KEY=your_pusher_key
NEXT_PUBLIC_PUSHER_CLUSTER=your_pusher_cluster

# IndexNow Protocol (Instant search engine indexing for Bing, Yandex, Seznam, Naver)
INDEXNOW_KEY=05b1a843c7594001ad7c45cce6934b7d
INDEXNOW_SECRET=your_optional_indexnow_api_secret
