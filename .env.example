# Contentful CMS (Required for /life and /skills certificates)
CONTENTFUL_SPACE_ID=your_contentful_space_id
CONTENTFUL_ACCESS_TOKEN=your_contentful_access_token

# ISR Revalidation Secret (Protects POST /api/revalidate)
REVALIDATE_SECRET=your_revalidate_secret_token

# Pusher Server Keys
PUSHER_APP_ID=your_pusher_app_id
PUSHER_SECRET=your_pusher_secret

# Pusher Client Keys
NEXT_PUBLIC_PUSHER_KEY=your_pusher_key
NEXT_PUBLIC_PUSHER_CLUSTER=your_pusher_cluster

# IndexNow Protocol (Instant search engine indexing for Bing, Yandex, Seznam, Naver)
INDEXNOW_KEY=05b1a843c7594001ad7c45cce6934b7d
INDEXNOW_SECRET=your_optional_indexnow_api_secret

# SupportKori Webhook & Telegram Alerts (/api/webhooks/supportkori)
SUPPORTKORI_WEBHOOK_SECRET=your_supportkori_signing_secret
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# First-Party Analytics (Vercel KV / Upstash Redis + /admin Password Gate)
ANALYTICS_KV_REST_API_URL=https://your-upstash-instance.upstash.io
ANALYTICS_KV_REST_API_TOKEN=your_analytics_kv_rest_api_token
ADMIN_PASSWORD=choose_a_strong_admin_password
# Optional: override the HMAC signing/hashing secrets (defaults derive from ADMIN_PASSWORD / KV token)
ADMIN_SESSION_SECRET=optional_random_32_byte_hex_secret
ANALYTICS_HASH_SALT=optional_random_32_byte_hex_salt
