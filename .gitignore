# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
# npm logs are not relevant; pnpm is used
yarn-debug.log*
yarn-error.log*

# environment and secret files
.env
.env.*
!.env.example

# credentials and private keys
*.key
*.p12
*.pfx
*.jks
credentials.json
service-account*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local security and audit output
*.log
*.secretlint*
.gitleaks*

# temporary office lockfiles and cache
~$*
*.tmp

# pnpm is the repository package manager
package-lock.json